# TEXA — variabili d'ambiente (copia in .env).

# --- Supabase (import dati fornitori: scripts/importToSupabase.mjs) ---
# URL del progetto e SERVICE ROLE key (segreta, solo lato server).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Pipeline di arricchimento (scripts/enrich.mjs) ---
# Compila almeno UNA fonte. La più affidabile per PEC/ATECO verificati
# è Registro Imprese/InfoCamere.

# Registro Imprese / InfoCamere (consigliata: PEC, P.IVA, ATECO ufficiali)
REGISTRO_IMPRESE_KEY=
# REGISTRO_IMPRESE_URL=https://api.infocamere.it/registroimprese/v1

# Europages (directory B2B tessile) — opzionale
EUROPAGES_KEY=

# Kompass (directory B2B) — opzionale
KOMPASS_KEY=

# Google Programmable Search (fallback, NIENTE scraping) — opzionale
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# In alternativa:
SERPAPI_KEY=
